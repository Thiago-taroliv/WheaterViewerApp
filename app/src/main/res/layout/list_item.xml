<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- MUDANÇA AQUI: Trocamos ImageView por TextView para exibir o Emoji -->
    <TextView
        android:id="@+id/conditionIconView"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="30sp"
        android:text="☀" 
        android:contentDescription="@string/weather_condition_image" />

    <GridLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <TextView
            android:id="@+id/dayTextView"
            android:layout_column="0"
            android:layout_columnSpan="3"
            android:layout_gravity="fill_horizontal"
            android:text="Day"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/lowTextView"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:text="Low" />

        <TextView
            android:id="@+id/hiTextView"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:text="High" />

        <TextView
            android:id="@+id/humidityTextView"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:text="Humidity" />

    </GridLayout>
</LinearLayout>