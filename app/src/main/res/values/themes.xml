<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeatherViewerApp" parent="Theme.Material3.DayNight.NoActionBar">
        
        <!-- Cor Principal (Toolbar, Botões ativos) -->
        <item name="colorPrimary">@color/primary_blue</item>
        
        <!-- Cor da Barra de Status (Aquela barra do relógio/bateria) -->
        <item name="android:statusBarColor">#4C8EFF</item>
        
        <!-- Cor dos textos da barra de status (False = Texto Branco, True = Texto Preto) -->
        <!-- Como o fundo é azul escuro, queremos texto branco -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Cor de fundo das janelas -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <!-- Cor da borda e do Label quando FOCADO (Ativo) -->
        <item name="hintTextColor">@color/input_accent</item>

        <!-- Cor da borda e do Label quando EM REPOUSO (Sem foco) -->
        <item name="android:textColorHint">@color/input_accent</item>

        <!-- Cor do texto que o usuário digita -->
        <item name="android:textColor">@color/text_typing</item>
        <item name="editTextColor">@color/text_typing</item>
    </style>
    <style name="Theme.WeatherViewerApp" parent="Base.Theme.WeatherViewerApp" />
</resources>